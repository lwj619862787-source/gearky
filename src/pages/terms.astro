---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Terms of Use"
  description={`Terms of use for ${site.name}.`}
  noindex
>
  <section class="page">
    <div class="container container--narrow">
      <h1>Terms of Use</h1>
      <div class="prose">
        <p>Last updated: {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        <p>
          By accessing {site.domain}, you agree to these Terms of Use. If you do not agree,
          please do not use this site.
        </p>
        <h2>Content</h2>
        <p>
          All content on Gearky is provided for general informational purposes only. While
          we strive for accuracy, we make no warranties about the completeness, reliability,
          or accuracy of any information. Product availability, pricing, and specifications
          may change at any time.
        </p>
        <h2>Affiliate links</h2>
        <p>
          Gearky participates in affiliate advertising programs. We may earn a commission
          on qualifying purchases made through links on this site. This does not affect the
          price you pay. See our <a href="/disclosure/">affiliate disclosure</a>.
        </p>
        <h2>Intellectual property</h2>
        <p>
          Gearky and its content are protected by applicable intellectual property laws.
          Product names, logos, and brands mentioned on this site (including PlayStation)
          are trademarks of their respective owners and are used for identification only.
          Gearky is not affiliated with or endorsed by those owners.
        </p>
        <h2>Limitation of liability</h2>
        <p>
          To the maximum extent permitted by law, Gearky shall not be liable for any
          damages arising from your use of, or inability to use, this site or its content.
        </p>
        <h2>Contact</h2>
        <p>
          Questions? Email <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12);
  }
</style>
