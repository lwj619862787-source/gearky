import type { ArticleMeta } from '../../types/article';

export const meta: ArticleMeta = {
  title: 'PS5 Stand: Do You Need One? Prices, Types & the Best Vertical Stands (2026)',
  description:
    'Does your PS5 need a stand? The Slim and Pro do not include a vertical stand. Compare the $29 official Sony stand against $10–$16 third-party bases and all-in-one charging/cooling stands.',
  category: 'controllers',
