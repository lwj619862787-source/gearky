  .article-figure {
    margin: var(--space-6) 0;
  }
  .article-figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }
  .article-figure figcaption {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: var(--space-2);
    text-align: center;
  }
</style>
