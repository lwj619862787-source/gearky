---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Affiliate Disclosure"
  description={`How ${site.name} earns money through affiliate links.`}
  noindex
>
  <section class="page">
    <div class="container container--narrow">
      <h1>Affiliate Disclosure</h1>
      <div class="prose">
        <p>
          Gearky participates in affiliate advertising programs. When you click certain
          links on our site and make a purchase, we may earn a commission from the
          retailer — at no additional cost to you.
        </p>
        <h2>Our promise to readers</h2>
        <ul>
          <li>We never accept payment in exchange for a positive review.</li>
          <li>Affiliate relationships do not influence our editorial opinions.</li>
          <li>We clearly label affiliate links and product recommendations.</li>
          <li>We disclose when a product was provided to us for review.</li>
        </ul>
        <p>
          If you have any questions about how we make money or how a specific link works,
          please <a href="/contact/">contact us</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12);
  }
</style>
