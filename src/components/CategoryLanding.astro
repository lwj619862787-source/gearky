---
import Card from './Card.astro';
import { categories } from '../data/site';
import type { Category } from '../data/site';
import type { Post } from '../types/article';

interface Props {
  category: Category;
  posts: Post[];
}

const { category, posts } = Astro.props;
const related = categories.filter((c) => c.slug !== category.slug);
---

<section class="cat-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span class="current">{category.label}</span>
    </nav>
    <h1 class="cat-title">{category.title}</h1>
    <p class="cat-desc">{category.description}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    {
      posts.length > 0 ? (
        <div class="card-grid">
          {posts.map((p) => <Card post={p} />)}
        </div>
      ) : (
        <p class="empty-note">
          Guides in this category are coming soon. Check back shortly.
        </p>
      )
    }
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <h2 class="section-title">Explore more</h2>
    <div class="related-grid">
      {related.map((c) => (
        <a href={`/${c.slug}/`} class="related-card">
          <span class="related-label">{c.label}</span>
          <span class="related-blurb">{c.blurb}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .cat-hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-10);
  }
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
  .breadcrumbs .current {
    color: var(--color-text-faint);
  }
  .cat-title {
    margin-bottom: var(--space-3);
  }
  .cat-desc {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    max-width: 65ch;
    margin: 0;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .empty-note {
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-10);
    text-align: center;
  }

  .section--alt {
    background: var(--color-surface);
  }
  .section-title {
    margin-bottom: var(--space-6);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    color: inherit;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .related-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    color: inherit;
  }
  .related-label {
    font-weight: 700;
    color: var(--color-primary);
  }
  .related-blurb {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .card-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
